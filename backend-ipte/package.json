{
  "name": "backend-ipte",
  "version": "2.0.0",
  "description": "PTE iPASS backend: Express + TypeScript + Prisma + PostgreSQL",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "contract:sync": "node scripts/sync-contract.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/backup.mjs",
    "db:migrate-legacy": "tsx scripts/migrate-legacy.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.13",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
