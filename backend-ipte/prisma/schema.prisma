// PTE iPASS — schema v2 (PostgreSQL).
// Nguyên tắc: một bảng cho mỗi thực thể nghiệp vụ; PK uuid; created_at/updated_at; ràng buộc FK rõ ràng;
// giá trị lồng (form fields, sections, availability…) lưu JSONB vì thuộc sở hữu bản ghi cha.
// Bảng legacy nằm ở database cũ (ipte) và KHÔNG bị chạm tới; xem docs/migration.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────────
enum ContentStatus {
  draft
  review
  published
  archived
}

enum ActiveStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
  locked
}

enum Gender {
  female
  male
  other
}

enum StudentStatus {
  active
  paused
  closed
}

enum LeadSource {
  facebook
  google
  tiktok
  zalo
  referral
  website
  offline
  other
}

enum JourneyStage {
  lead
  test
  enroll
  learn
  mock
  exam
  result
}

enum JourneyEventKind {
  stage
  note
}

enum LearningPurpose {
  study_abroad
  migration
  work
  scholarship
  other
}

enum TargetCountry {
  AU
  NZ
  CA
  UK
  US
  VN
  OTHER
}

enum StudyMode {
  online
  offline
  hybrid
}

enum PteSkill {
  speaking
  writing
  reading
  listening
}

enum CourseType {
  preparation
  target_score
  intensive
  core
  one_on_one
  pronunciation
}

enum CourseStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  live
  practice
  mock_test
  webinar
}

enum LessonStatus {
  draft
  published
}

enum PathStatus {
  draft
  active
  paused
  completed
}

enum StepStatus {
  pending
  in_progress
  done
}

enum MaterialType {
  video
  pdf
  document
  link
  worksheet
}

enum MaterialVisibility {
  public
  enrolled
  staff
}

enum MaterialStatus {
  draft
  published
}

enum Difficulty {
  easy
  medium
  hard
}

enum QuestionStatus {
  draft
  published
  archived
}

enum TeacherStatus {
  active
  on_leave
  inactive
}

enum BranchCountry {
  VN
  AU
}

enum RoomType {
  classroom
  lab
  meeting
  online
}

enum RoomStatus {
  available
  maintenance
}

enum PageTemplate {
  landing
  static
}

enum FormType {
  trial_registration
  consultation
  placement_booking
  contact
  other
}

enum SubmissionStatus {
  new
  contacted
  qualified
  converted
  spam
}

enum BannerPlacement {
  home_hero
  home_secondary
  courses
  news
  popup
}

enum BannerStatus {
  draft
  active
  inactive
}

enum MediaKind {
  image
  video
  audio
  document
}

enum NotificationChannel {
  email
  sms
  zalo
}

enum AuditAction {
  create
  update
  delete
  login
  approve
  export
}

// ── IAM ─────────────────────────────────────────────────────────────────────
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(80)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  /// "resource.action", ví dụ student.view
  code     String           @unique @db.VarChar(80)
  resource String           @db.VarChar(60)
  action   String           @db.VarChar(30)
  roles    RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique @db.VarChar(160)
  passwordHash   String         @map("password_hash")
  fullName       String         @map("full_name") @db.VarChar(120)
  phone          String?        @db.VarChar(30)
  roleId         String         @map("role_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  status         UserStatus     @default(active)
  avatarUrl      String?        @map("avatar_url")
  lastLoginAt    DateTime?      @map("last_login_at") @db.Timestamptz(6)
  failedAttempts Int            @default(0) @map("failed_attempts")
  /// Mật khẩu tạm do quản trị cấp: bắt buộc đổi ở lần đăng nhập kế tiếp.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lockedUntil    DateTime?      @map("locked_until") @db.Timestamptz(6)
  /// Tăng khi đổi mật khẩu / thu hồi phiên: vô hiệu hóa mọi access token cũ.
  tokenVersion   Int            @default(0) @map("token_version")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  refreshTokens  RefreshToken[]
  assignedStudents Student[]
  assignedSubmissions FormSubmission[]
  articles       Article[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Mọi token sinh ra từ một lần đăng nhập chung một family: phát hiện tái sử dụng ⇒ thu hồi cả family.
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorId     String?     @map("actor_id") @db.Uuid
  actorName   String      @map("actor_name") @db.VarChar(120)
  actorRole   String      @map("actor_role") @db.VarChar(80)
  action      AuditAction
  resource    String      @db.VarChar(60)
  entityId    String      @map("entity_id") @db.VarChar(80)
  entityLabel String      @map("entity_label")
  before      Json?
  after       Json?
  ip          String?     @db.VarChar(64)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([resource, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

// ── Tổ chức ─────────────────────────────────────────────────────────────────
model Branch {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(30)
  name         String        @db.VarChar(160)
  country      BranchCountry
  city         String        @db.VarChar(100)
  address      String
  phone        String        @db.VarChar(30)
  email        String?       @db.VarChar(160)
  managerName  String?       @map("manager_name") @db.VarChar(120)
  openingHours String?       @map("opening_hours") @db.VarChar(120)
  mapUrl       String?       @map("map_url")
  status       ActiveStatus  @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  rooms        Room[]
  teachers     Teacher[]
  students     Student[]
  users        User[]

  @@map("branches")
}

model Room {
  id        String     @id @default(uuid()) @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  name      String     @db.VarChar(100)
  capacity  Int
  type      RoomType
  status    RoomStatus @default(available)
  equipment String[]   @default([])
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, name])
  @@map("rooms")
}

model Teacher {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique @db.VarChar(30)
  slug           String        @unique @db.VarChar(160)
  fullName       String        @map("full_name") @db.VarChar(120)
  email          String        @unique @db.VarChar(160)
  phone          String?       @db.VarChar(30)
  avatarUrl      String?       @map("avatar_url")
  headline       String?       @db.VarChar(160)
  bio            String?
  pteScore       Int?          @map("pte_score")
  yearsExperience Int          @default(0) @map("years_experience")
  specialties    PteSkill[]    @default([])
  qualifications String[]      @default([])
  branchId       String?       @map("branch_id") @db.Uuid
  status         TeacherStatus @default(active)
  availability   Json          @default("[]")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  courses        CourseTeacher[]

  @@index([status])
  @@map("teachers")
}

// ── Khóa học ────────────────────────────────────────────────────────────────
model CourseCategory {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(160)
  slug        String           @unique @db.VarChar(160)
  description String?
  parentId    String?          @map("parent_id") @db.Uuid
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent      CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    CourseCategory[] @relation("CategoryTree")
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique @db.VarChar(40)
  name            String         @db.VarChar(200)
  slug            String         @unique @db.VarChar(200)
  categoryId      String         @map("category_id") @db.Uuid
  type            CourseType
  targetScore     Int?           @map("target_score")
  entryLevel      String         @default("none") @map("entry_level") @db.VarChar(10)
  mode            StudyMode
  durationWeeks   Int            @map("duration_weeks")
  sessionsCount   Int            @map("sessions_count")
  /// VND. 0 = liên hệ tư vấn.
  tuition         Int            @default(0)
  summary         String
  description     String?
  outcomes        String[]       @default([])
  audience        String[]       @default([])
  status          CourseStatus   @default(draft)
  isFeatured      Boolean        @default(false) @map("is_featured")
  thumbnailUrl    String?        @map("thumbnail_url")
  metaTitle       String?        @map("meta_title")
  metaDescription String?        @map("meta_description")
  enrolledCount   Int            @default(0) @map("enrolled_count")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  category        CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  teachers        CourseTeacher[]
  lessons         Lesson[]
  materials       LearningMaterial[]
  pathSteps       LearningPathStep[]
  testimonials    Testimonial[]

  @@index([categoryId])
  @@index([status, isFeatured])
  @@map("courses")
}

model CourseTeacher {
  courseId  String  @map("course_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([courseId, teacherId])
  @@index([teacherId])
  @@map("course_teachers")
}

model Lesson {
  id              String       @id @default(uuid()) @db.Uuid
  courseId        String       @map("course_id") @db.Uuid
  title           String       @db.VarChar(200)
  position        Int          @map("position")
  type            LessonType
  skill           PteSkill?
  durationMinutes Int          @map("duration_minutes")
  objectives      String?
  status          LessonStatus @default(draft)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials       LearningMaterial[]

  @@index([courseId, position])
  @@map("lessons")
}

model LearningMaterial {
  id              String             @id @default(uuid()) @db.Uuid
  title           String             @db.VarChar(200)
  type            MaterialType
  url             String
  description     String?
  skill           PteSkill?
  questionType    String?            @map("question_type") @db.VarChar(60)
  courseId        String?            @map("course_id") @db.Uuid
  lessonId        String?            @map("lesson_id") @db.Uuid
  fileSizeKb      Int?               @map("file_size_kb")
  durationSeconds Int?               @map("duration_seconds")
  tags            String[]           @default([])
  visibility      MaterialVisibility @default(enrolled)
  status          MaterialStatus     @default(draft)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  course          Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson          Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([lessonId])
  @@map("learning_materials")
}

// ── Học viên ────────────────────────────────────────────────────────────────
model Student {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique @db.VarChar(30)
  fullName   String        @map("full_name") @db.VarChar(120)
  gender     Gender        @default(other)
  dateOfBirth DateTime?    @map("date_of_birth") @db.Date
  email      String        @db.VarChar(160)
  phone      String        @db.VarChar(30)
  zalo       String?       @db.VarChar(40)
  city       String?       @db.VarChar(100)
  address    String?
  source     LeadSource    @default(website)
  branchId   String?       @map("branch_id") @db.Uuid
  assignedTo String?       @map("assigned_to") @db.Uuid
  status     StudentStatus @default(active)
  stage      JourneyStage  @default(lead)
  tags       String[]      @default([])
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignee   User?         @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  profile    StudentProfile?
  events     JourneyEvent[]
  paths      LearningPath[]

  @@unique([email])
  @@index([stage])
  @@index([status])
  @@index([branchId])
  @@index([assignedTo])
  @@index([createdAt(sort: Desc)])
  @@map("students")
}

model StudentProfile {
  studentId          String          @id @map("student_id") @db.Uuid
  currentLevel       String          @default("none") @map("current_level") @db.VarChar(10)
  currentScore       Int?            @map("current_score")
  skillScores        Json?           @map("skill_scores")
  targetScore        Int             @map("target_score")
  purpose            LearningPurpose
  purposeDetail      String?         @map("purpose_detail")
  targetCountry      TargetCountry?  @map("target_country")
  examDeadline       DateTime?       @map("exam_deadline") @db.Date
  studyHoursPerWeek  Int?            @map("study_hours_per_week")
  preferredMode      StudyMode       @default(online) @map("preferred_mode")
  preferredSchedule  String?         @map("preferred_schedule")
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  student            Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model JourneyEvent {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  kind          JourneyEventKind
  stage         JourneyStage
  title         String           @db.VarChar(200)
  note          String?
  data          Json?
  createdByName String           @map("created_by_name") @db.VarChar(120)
  occurredAt    DateTime         @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, occurredAt])
  @@index([stage, occurredAt])
  @@map("student_journey_events")
}

model LearningPath {
  id           String             @id @default(uuid()) @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  title        String             @db.VarChar(200)
  currentLevel String             @map("current_level") @db.VarChar(10)
  targetScore  Int                @map("target_score")
  deadline     DateTime?          @db.Date
  startDate    DateTime           @map("start_date") @db.Date
  weeklyHours  Int                @map("weekly_hours")
  status       PathStatus         @default(draft)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps        LearningPathStep[]

  @@index([studentId])
  @@index([status])
  @@map("learning_paths")
}

model LearningPathStep {
  id          String       @id @default(uuid()) @db.Uuid
  pathId      String       @map("path_id") @db.Uuid
  position    Int
  title       String       @db.VarChar(200)
  courseId    String?      @map("course_id") @db.Uuid
  targetScore Int?         @map("target_score")
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  status      StepStatus   @default(pending)
  note        String?
  path        LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([pathId, position])
  @@map("learning_path_steps")
}

model Question {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(40)
  skill         PteSkill
  type          String         @db.VarChar(60)
  prompt        String
  content       String?
  mediaUrl      String?        @map("media_url")
  options       Json           @default("[]")
  answerKey     String?        @map("answer_key")
  difficulty    Difficulty     @default(medium)
  targetBand    Int?           @map("target_band")
  tags          String[]       @default([])
  status        QuestionStatus @default(draft)
  createdByName String         @map("created_by_name") @db.VarChar(120)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([skill, type])
  @@index([status])
  @@map("questions")
}

// ── CMS & website ───────────────────────────────────────────────────────────
model Page {
  id              String        @id @default(uuid()) @db.Uuid
  title           String        @db.VarChar(200)
  slug            String        @unique @db.VarChar(200)
  template        PageTemplate
  status          ContentStatus @default(draft)
  summary         String?
  content         String?
  sections        Json          @default("[]")
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  canonicalUrl    String?       @map("canonical_url")
  noindex         Boolean       @default(false)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  updatedByName   String?       @map("updated_by_name") @db.VarChar(120)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("pages")
}

model ArticleCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @unique @db.VarChar(160)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  articles    Article[]

  @@map("article_categories")
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(80)
  slug      String       @unique @db.VarChar(100)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  articles  ArticleTag[]

  @@map("tags")
}

model Article {
  id              String          @id @default(uuid()) @db.Uuid
  title           String          @db.VarChar(250)
  slug            String          @unique @db.VarChar(250)
  excerpt         String
  content         String
  coverUrl        String?         @map("cover_url")
  categoryId      String          @map("category_id") @db.Uuid
  authorId        String?         @map("author_id") @db.Uuid
  isFeatured      Boolean         @default(false) @map("is_featured")
  status          ContentStatus   @default(draft)
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(6)
  metaTitle       String?         @map("meta_title")
  metaDescription String?         @map("meta_description")
  readingMinutes  Int             @default(1) @map("reading_minutes")
  viewCount       Int             @default(0) @map("view_count")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  category        ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author          User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags            ArticleTag[]

  @@index([categoryId])
  @@index([status, publishedAt(sort: Desc)])
  @@map("articles")
}

model ArticleTag {
  articleId String  @map("article_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Form {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(160)
  slug           String           @unique @db.VarChar(160)
  type           FormType
  description    String?
  fields         Json             @default("[]")
  submitLabel    String           @map("submit_label") @db.VarChar(80)
  successMessage String           @map("success_message")
  notifyEmails   String[]         @default([]) @map("notify_emails")
  status         ActiveStatus     @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  submissions    FormSubmission[]

  @@map("forms")
}

model FormSubmission {
  id         String           @id @default(uuid()) @db.Uuid
  formId     String           @map("form_id") @db.Uuid
  formName   String           @map("form_name") @db.VarChar(160)
  formType   FormType         @map("form_type")
  data       Json
  fullName   String?          @map("full_name") @db.VarChar(160)
  email      String?          @db.VarChar(160)
  phone      String?          @db.VarChar(40)
  status     SubmissionStatus @default(new)
  assignedTo String?          @map("assigned_to") @db.Uuid
  notes      String?
  source     Json?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  form       Form             @relation(fields: [formId], references: [id], onDelete: Restrict)
  assignee   User?            @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([status, createdAt(sort: Desc)])
  @@map("form_submissions")
}

model Testimonial {
  id          String        @id @default(uuid()) @db.Uuid
  studentName String        @map("student_name") @db.VarChar(120)
  headline    String        @db.VarChar(200)
  quote       String
  avatarUrl   String?       @map("avatar_url")
  scoreBefore Int?          @map("score_before")
  scoreAfter  Int           @map("score_after")
  rating      Int           @default(5)
  courseId    String?       @map("course_id") @db.Uuid
  videoUrl    String?       @map("video_url")
  isFeatured  Boolean       @default(false) @map("is_featured")
  status      ContentStatus @default(draft)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@map("testimonials")
}

model Banner {
  id           String          @id @default(uuid()) @db.Uuid
  title        String          @db.VarChar(200)
  placement    BannerPlacement
  imageUrl     String          @map("image_url")
  mobileImageUrl String?       @map("mobile_image_url")
  linkUrl      String?         @map("link_url")
  altText      String?         @map("alt_text")
  startAt      DateTime?       @map("start_at") @db.Date
  endAt        DateTime?       @map("end_at") @db.Date
  status       BannerStatus    @default(draft)
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([placement, status])
  @@map("banners")
}

model MediaItem {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  kind      MediaKind
  url       String
  mimeType  String?   @map("mime_type") @db.VarChar(100)
  sizeKb    Int?      @map("size_kb")
  width     Int?
  height    Int?
  altText   String?   @map("alt_text")
  folder    String    @default("general") @db.VarChar(80)
  tags      String[]  @default([])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kind, folder])
  @@map("media_items")
}

// ── Hệ thống ────────────────────────────────────────────────────────────────
/// Cấu hình website (singleton: id = 'site').
model SiteConfig {
  id            String   @id @default("site") @db.VarChar(20)
  general       Json
  contact       Json
  social        Json
  policies      Json     @default("[]")
  chat          Json
  tracking      Json
  updatedByName String?  @map("updated_by_name") @db.VarChar(120)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_config")
}

/// Cài đặt hệ thống theo nhóm ('global' | 'integration'). Bí mật nằm ở `secrets` (mã hóa AES-GCM), không bao giờ trả ra API.
model Setting {
  group         String   @id @db.VarChar(40)
  value         Json
  secrets       Json?
  updatedByName String?  @map("updated_by_name") @db.VarChar(120)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  key       String              @unique @db.VarChar(80)
  name      String              @db.VarChar(160)
  channel   NotificationChannel
  subject   String?
  body      String
  variables String[]            @default([])
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_templates")
}

/// Bộ đếm sinh mã tuần tự (HV-00001, GV-001…), cập nhật nguyên tử trong transaction.
model Counter {
  name  String @id @db.VarChar(40)
  value Int    @default(0)

  @@map("counters")
}

/// Ánh xạ bản ghi legacy → bản ghi mới: làm cho script migrate chạy lại an toàn (idempotent) và cho phép đối soát/rollback.
model LegacyMap {
  source     String   @db.VarChar(60)
  sourceId   String   @map("source_id") @db.VarChar(60)
  targetTable String  @map("target_table") @db.VarChar(60)
  targetId   String   @map("target_id") @db.VarChar(80)
  migratedAt DateTime @default(now()) @map("migrated_at") @db.Timestamptz(6)

  @@id([source, sourceId])
  @@index([targetTable, targetId])
  @@map("legacy_map")
}
