# Server
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
TRUST_PROXY=false

# Database (PostgreSQL). KHÔNG commit giá trị thật.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ipte_v2
# Chỉ dùng cho script migrate dữ liệu cũ (đọc)
LEGACY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ipte

# Auth
JWT_ACCESS_SECRET=<chuoi-ngau-nhien-it-nhat-32-ky-tu>
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=14
SECRETS_KEY=<64-ky-tu-hex-ngau-nhien>

# CORS / cookie
CORS_ALLOWED_ORIGINS=http://localhost:3000
# COOKIE_SECURE=true

# Website revalidate webhook (tùy chọn)
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# WEB_REVALIDATE_SECRET=

# SMTP (tùy chọn)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# reCAPTCHA v3 (tùy chọn)
# RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

UPLOAD_DIR=storage

# Tài khoản Admin đầu tiên (chỉ dùng khi chạy `npm run db:seed`). Đổi ngay sau lần đăng nhập đầu; KHÔNG dùng giá trị mẫu ở production.
SEED_ADMIN_EMAIL=admin@pteipass.vn
SEED_ADMIN_PASSWORD=Dev-Admin-Passw0rd1
